---
// Blog Index Page
// ------------
// Description: The blog index page.

// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - UI
import Hero from '../../components/blocks/hero/PageHeader.astro'
import BlogPosts from '../../components/blocks/blog/BlogPosts.astro'

// Data
import { getCollection } from 'astro:content'

// Content
// - SEO
const SEO = {
	title: 'Nuestra Misión | OSSEPT',
	description:
		"Creando unidad sindical"
}
// - Page Header
const header = {
	title: '<span class="text-cyan-500">Nuestra Misión</span>',
	paragraphs: [
		'Fortalecer la representatividad, la unidad sindical y el despliegue de la capacidad de OSSEPT, generando iniciativas y propuestas que contribuyan al logro de mejores condiciones de trabajo para el bienestar de los funcionarios públicos y de sus familias.',
		'Las organizaciones sindicales como OSSEPT definen la eficacia del desarrollo como la generación de resultados sociales positivos en términos de trabajo decente, protección social, diálogo social, respeto de los derechos humanos y sindicales, igualdad de género, sostenibilidad medioambiental, bienestar y un sustento de vida digno para todas las personas.',
		'Con el compromiso de todos para:'
	],
	listItems: [
		'Impulsar el liderazgo y la formación integral de los trabajadores.',
		'Gestionar condiciones excelentes de salud, seguridad y buenas prácticas laborales.',
		'Fortalecer la unidad y la solidaridad, generando espacios para dirimir diferencias.',
		'Luchar con vehemencia para defender los derechos de los servidores públicos territoriales.',
		'Manejar con transparencia y honestidad los recursos de la organización.'
	]
}

const allPosts = await getCollection('blog')
---

<Layout title={SEO.title} description={SEO.description}>
		<Hero title={header.title} titleClasses="text-cyan-500" paragraphs={header.paragraphs} listItems={header.listItems} />

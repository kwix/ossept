---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import Card from '../components/ui/cards/partials/Card.astro'
import Form from '../components/ui/forms/Form.astro'
import FormField from '../components/ui/forms/partials/FormField.astro'
import InputField from '../components/ui/forms/form-elements/InputField.astro'

// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')

// Content
import faqImage1 from '../assets/faq/faq-01.png'
// - SEO
const SEO = {
	title: 'Certificado de Afiliación | OSSEPT',
	description:
		'Descarga tu certificado de afiliación a OSSEPT y demuestra tu compromiso con la organización sindical. Accede a tu certificado de manera rápida y sencilla, garantizando la validez y autenticidad de tu afiliación.'
}
// - Page Header
const header = {
	title: '<span class="text-cyan-500">Certiifcados de Afiliación</span>',
	text: 'Accede a tu certificado de afiliado, de manera rápida y sencilla, garantizando la validez y autenticidad de tu afiliación a nuestra organización '
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<Card classes="mb-16 p-8">
		<Form id="certificate-form" classes="max-w-xl">
			<h2 class="text-3xl font-semibold mb-4">Generar Certificado de Afiliación</h2>
			<FormField classes="flex-col gap-4">
				<InputField id="affiliateId" label="Cédula de ciudadanía" type="text" required />
			</FormField>
			<div class="mt-4">
				<button id="downloadCertificate" type="button" class="button button--primary">Descargar certificado</button>
			</div>
			<p id="certificate-message" class="mt-3 text-sm text-red-600"></p>
		</Form>
	</Card>

	
	
	

	<script type="module">
		const button = document.getElementById('downloadCertificate')
		const message = document.getElementById('certificate-message')
		const input = document.getElementById('affiliateId')

		if (button instanceof HTMLButtonElement) {
			button.addEventListener('click', async (event) => {
				event.preventDefault()
				event.stopPropagation()
				message.textContent = ''

				const cedula = input instanceof HTMLInputElement ? input.value.trim() : ''
				if (!cedula) {
					message.textContent = 'Por favor ingresa la cédula de ciudadanía.'
					return
				}

				button.disabled = true
				button.textContent = 'Generando...'

				try {
					const response = await fetch(`${window.location.origin}/api/certificate`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ cedula })
					})

					if (!response.ok) {
						const error = await response.json().catch(() => ({ error: 'Error al generar el certificado.' }))
						message.textContent = error.error || 'Error al generar el certificado.'
						return
					}

					const blob = await response.blob()
					const url = window.URL.createObjectURL(blob)
					const anchor = document.createElement('a')
					anchor.href = url
					anchor.download = 'certificado-afiliacion.pdf'
					document.body.appendChild(anchor)
					anchor.click()
					anchor.remove()
					window.URL.revokeObjectURL(url)
				} catch (error) {
					message.textContent = 'Error de red al generar el certificado.'
				} finally {
					button.disabled = false
					button.textContent = 'Descargar certificado'
				}
			})
		}
	</script>
</Layout>

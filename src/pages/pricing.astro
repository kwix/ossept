---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={sigue.title} text={sigue.text} />
	<Testimonial
		bg={testimonialBackground} 
		bgPosition="center"/>
	<Hero title={header.title} text={header.text} />
	<Testimonial
		bg={testimonialBackground1} 
		bgPosition="center"/>
	<Hero title={cumple.title} text={cumple.text} />
	<Testimonial
		bg={testimonialBackground2} 
		bgPosition="center"/>
